        "title": "container.ts",
        "lines": [
          "type Factory = (c: Container) => unknown;",
          "",
          "export class Container {",
          "  private factories = new Map<string, Factory>();",
          "  private instances = new Map<string, unknown>();",
          "",
          "  register(name: string, factory: Factory) {",
          "    this.factories.set(name, factory);",
          "  }",
          "",
          "  resolve<T>(name: string): T {",
          "    if (!this.instances.has(name)) {",
          "      const factory = this.factories.get(name);",
          "      if (!factory) throw new Error(`nada registrado como \"${name}\"`);",
          "      this.instances.set(name, factory(this));",
          "    }",
          "    return this.instances.get(name) as T;",
          "  }",
          "}"
        ],
        "highlight": []
      },
      "text": "No fundo, um contêiner é isso: um mapa de receitas por nome. Quando alguém pede uma peça, ele monta e guarda."
    },
